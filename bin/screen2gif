#!/bin/sh
':' //; command -v node >/dev/null 2>&1 || { echo '✗ 需要 Node.js >= 18。安装：brew install node' >&2; exit 127; }
':' //; exec node "$0" "$@"
import { mkdtemp, rm, readdir, stat, copyFile, mkdir } from 'node:fs/promises';
import { tmpdir, homedir } from 'node:os';
import { join, resolve, basename, dirname } from 'node:path';
import { spawn } from 'node:child_process';
import {
  ffmpeg, ffprobe, probe, detectCrop, normalizeCrop, extractKeyframes,
  applyFrameCap, applyFrameRate, computeDelays, buildConcatList, encodeGif, SENSITIVITY,
} from '../lib/video.mjs';
import { record, frontWindowRegion, checkPermission } from '../lib/record.mjs';
import { ensureFfmpeg, binWorks, responsibleAppName, openScreenCaptureSettings } from '../lib/deps.mjs';

const VERSION = '1.5.0';

const HELP = `screen2gif ${VERSION} — 录屏 → 关键帧 → 裁剪 → GIF

用法:
  screen2gif record  [选项]              录屏并直接产出 GIF
  screen2gif convert <视频> [选项]        已有视频转 GIF
  screen2gif doctor                      检查依赖与屏幕录制权限

输出:
  -o, --out <路径>        输出 GIF；给目录（已存在或以 / 结尾）则自动补
                          时间戳文件名 (默认 ./s2g-<时间戳>.gif)
  -w, --width <px>        输出宽度，0 = 不缩放 (默认 900)
      --no-palette        跳过调色板两遍编码 (更快，体积更大)

关键帧:
      --fps <n>           播放帧率上限；抽样保留最终状态 (默认 10)
      --sensitivity <档>  low | default | high，变化检测灵敏度 (默认 default)
      --max-frames <n>    关键帧上限，超出则均匀抽稀 (默认 240)
      --max-gap <秒>      单帧最长停留，长静默被截断 (默认 2.0)

裁剪:
      --crop <模式>       auto | off | x,y,w,h (默认 auto)
                          auto = 检测所有关键帧的运动包围盒，裁掉周围静止区域
      --pad <px>          auto 裁剪后的留白，源视频像素 (默认源宽的 1%)

录制:
  -d, --duration <秒>     定时录制；省略则按 Enter 手动停止
  -I, --interactive       用 macOS 原生录屏工具条：立即开始录制，点菜单栏
                          的停止按钮结束（在任何 App 里都能点）
      --then '<命令>'     录制期间执行命令（交给 sh -c），命令结束即停止录制；
                          与 -d/-I 互斥，倒计时默认 0，命令退出码非 0 会警告
      --ready-file <路径> 真正开始采集那一刻创建该文件（开跑前先清掉旧文件），
                          供外部脚本/agent 轮询等待录制就绪
      --countdown <秒>    开始前的倒计时 (默认 3，0 = 关闭)
      --silent            关闭开始/结束提示音
      --region <模式>     screen | window | x,y,w,h，单位为屏幕点 (默认 screen)
                          window = 录制启动时的前台窗口
      --clicks            录制时高亮鼠标点击
      --display <n>       显示器编号，1 = 主屏

调试:
      --keep-mov          保留原始录屏到输出目录
      --keep-frames       保留关键帧 PNG 到输出目录
      --verbose           打印实际执行的 ffmpeg 命令
  -q, --quiet             只输出结果
      --json              成功时 stdout 输出单行 JSON（路径/帧数/时长/体积等）
  -h, --help              显示帮助
  -V, --version           显示版本`;

function fail(msg) { throw new Error(msg); }

function parseArgs(argv) {
  const o = {
    cmd: null, input: null, out: null, width: 900, palette: true,
    fps: 10, sensitivity: 'default', maxFrames: 240, maxGap: 2.0,
    crop: 'auto', pad: null, duration: null, region: 'screen',
    clicks: false, display: null, interactive: false, countdown: 3, silent: false,
    then: null, readyFile: null, json: false,
    keepMov: false, keepFrames: false, watermarkOverlay: null,
    verbose: false, quiet: false,
  };
  const num = (flag, v) => {
    const n = Number(v);
    if (!Number.isFinite(n)) fail(`${flag} 需要数字，收到 "${v}"`);
    return n;
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    const next = () => { const v = argv[++i]; if (v === undefined) fail(`${a} 缺少参数`); return v; };
    switch (a) {
      case 'record': case 'convert': case 'doctor':
        if (o.cmd) fail('只能指定一个子命令'); o.cmd = a; break;
      case '-o': case '--out': o.out = next(); break;
      case '-w': case '--width': o.width = Math.max(0, Math.round(num(a, next()))); break;
      case '--no-palette': o.palette = false; break;
      // Private app-to-CLI bridge: AppKit has already rendered text and emoji.
      case '--watermark-overlay': o.watermarkOverlay = resolve(next()); break;
      case '--fps':
        o.fps = num(a, next());
        if (o.fps < 1 || o.fps > 60) fail('--fps 需在 1-60 之间');
        break;
      case '--sensitivity':
        o.sensitivity = next();
        if (!SENSITIVITY[o.sensitivity]) fail(`--sensitivity 只能是 ${Object.keys(SENSITIVITY).join(' | ')}`);
        break;
      case '--max-frames':
        o.maxFrames = Math.round(num(a, next()));
        if (o.maxFrames < 1) fail('--max-frames 需为正整数（0 会被当成「无上限」，这里直接拒绝）');
        break;
      case '--max-gap':
        o.maxGap = num(a, next());
        if (o.maxGap <= 0) fail('--max-gap 需为正数');
        break;
      case '--crop': o.crop = next(); break;
      case '--pad':
        o.pad = Math.round(num(a, next()));
        if (o.pad < 0) fail('--pad 不能为负数');
        break;
      case '-d': case '--duration':
        o.duration = num(a, next());
        if (o.duration <= 0) fail('-d 需为正数秒（0 会退化成手动模式，这里直接拒绝）');
        break;
      case '-I': case '--interactive': o.interactive = true; break;
      case '--then':
        o.then = next();
        if (!o.then.trim()) fail('--then 需要一个命令字符串');
        break;
      case '--ready-file':
        o.readyFile = next();
        if (!o.readyFile.trim()) fail('--ready-file 需要一个路径');
        break;
      case '--countdown': o.countdown = Math.max(0, Math.round(num(a, next()))); break;
      case '--silent': o.silent = true; break;
      case '--region': o.region = next(); break;
      case '--clicks': o.clicks = true; break;
      case '--display': o.display = Math.round(num(a, next())); break;
      case '--keep-mov': o.keepMov = true; break;
      case '--keep-frames': o.keepFrames = true; break;
      case '--verbose': o.verbose = true; break;
      case '-q': case '--quiet': o.quiet = true; break;
      case '--json': o.json = true; break;
      case '-h': case '--help': process.stdout.write(HELP + '\n'); process.exit(0); break;
      case '-V': case '--version': process.stdout.write(VERSION + '\n'); process.exit(0); break;
      default:
        if (a.startsWith('-')) fail(`未知选项 ${a}（--help 看用法）`);
        if (o.input) fail(`只能指定一个输入文件，已收到 ${o.input} 和 ${a}`);
        o.input = a;
    }
  }
  // --then 的时长由命令决定，倒计时只会吞掉操作的开头——没显式给 --countdown 就归零
  if (o.then && !argv.includes('--countdown')) o.countdown = 0;
  return o;
}

function parseRect(spec, what) {
  const parts = spec.split(',').map((s) => Number(s.trim()));
  if (parts.length !== 4 || parts.some((n) => !Number.isFinite(n))) {
    fail(`${what} 需要 x,y,w,h 四个数字，收到 "${spec}"`);
  }
  const [x, y, w, h] = parts.map(Math.round);
  if (w < 8 || h < 8) fail(`${what} 的宽高不能小于 8`);
  return { x: Math.max(0, x), y: Math.max(0, y), w, h };
}

const listFrames = async (dir) => (await readdir(dir))
  .filter((f) => f.endsWith('.png'))
  .sort()
  .map((f) => join(dir, f));

function fmtBytes(n) {
  if (n < 1024) return `${n} B`;
  if (n < 1024 * 1024) return `${(n / 1024).toFixed(0)} KB`;
  return `${(n / 1024 / 1024).toFixed(2)} MB`;
}

async function resolveCrop(input, src, opts, work, pattern, log) {
  if (opts.crop === 'off') { log('  裁剪 off'); return null; }
  if (opts.crop !== 'auto') {
    const crop = parseRect(opts.crop, '--crop');
    if (crop.x + crop.w > src.width || crop.y + crop.h > src.height) {
      fail(`--crop ${opts.crop} 超出源画面 ${src.width}x${src.height}`);
    }
    log(`  裁剪 手动 ${crop.w}x${crop.h}+${crop.x}+${crop.y}`);
    return crop;
  }

  const analysisDir = join(work, 'analysis');
  await mkdir(analysisDir, { recursive: true });
  const analysisWidth = Math.min(1280, src.width);
  await extractKeyframes({
    input, outDir: analysisDir, pattern, crop: null,
    width: analysisWidth, sensitivity: opts.sensitivity,
    quiet: opts.quiet, label: '分析运动区域', verbose: opts.verbose,
  });
  const bbox = await detectCrop(analysisDir, pattern, { verbose: opts.verbose });
  const pad = opts.pad ?? Math.round(src.width * 0.01);
  // The bounding box is measured on the downscaled analysis frames, so it has
  // to be lifted back into source pixels before it can be used as a crop.
  const k = src.width / analysisWidth;
  const scaled = bbox && {
    x: Math.round(bbox.x * k), y: Math.round(bbox.y * k),
    w: Math.round(bbox.w * k), h: Math.round(bbox.h * k),
  };
  const crop = normalizeCrop(scaled, src.width, src.height, pad);
  log(crop
    ? `  裁剪 auto ${crop.w}x${crop.h}+${crop.x}+${crop.y} (留白 ${pad}px)`
    : '  裁剪 auto → 运动覆盖全画面，不裁剪');
  return crop;
}

async function convert(input, opts) {
  const log = (m) => { if (!opts.quiet) process.stderr.write(`${m}\n`); };
  const src = await probe(input);
  log(`  源 ${basename(input)}  ${src.width}x${src.height}  ${src.duration.toFixed(1)}s  ${src.nbFrames || '?'} 帧`);

  const work = await mkdtemp(join(tmpdir(), 's2g-'));
  const pattern = '%05d.png';
  const minInterval = 1 / opts.fps;
  try {
    const crop = await resolveCrop(input, src, opts, work, pattern, log);
    const outWidth = opts.width > 0 ? Math.min(opts.width, crop ? crop.w : src.width) : 0;

    const framesDir = join(work, 'frames');
    await mkdir(framesDir, { recursive: true });
    const times = await extractKeyframes({
      input, outDir: framesDir, pattern, crop, width: outWidth,
      sensitivity: opts.sensitivity,
      quiet: opts.quiet, label: '提取关键帧', verbose: opts.verbose,
    });
    const pngs = await listFrames(framesDir);
    if (!pngs.length) fail('没有检测到任何画面变化。试试 --sensitivity high，或确认视频确实动过。');
    if (pngs.length !== times.length) {
      fail(`关键帧数(${pngs.length})与时间戳数(${times.length})不一致，ffmpeg 行为异常`);
    }

    const sampled = applyFrameRate(times, minInterval);
    const kept = applyFrameCap(sampled, opts.maxFrames).map((i) => sampled[i]);
    if (kept.length < times.length) log(`  抽稀 ${times.length} → ${kept.length} 帧 (--max-frames ${opts.maxFrames})`);
    const frames = kept.map((i) => pngs[i]);
    const delays = computeDelays(kept.map((i) => times[i]), {
      minGap: minInterval, maxGap: opts.maxGap, endHold: 1.2,
    });

    const listFile = join(work, 'frames.txt');
    await buildConcatList(frames, delays, listFile);
    await encodeGif({
      listFile, out: opts.out, palette: opts.palette,
      watermark: opts.watermarkOverlay && {
        path: opts.watermarkOverlay,
        imageSize: await probe(opts.watermarkOverlay),
        frameSize: await probe(frames[0]),
      },
      quiet: opts.quiet, label: '编码 GIF', verbose: opts.verbose,
    });

    log(`  关键帧 ${frames.length} 帧  GIF 时长 ${(delays.reduce((s, d) => s + d, 0) / 100).toFixed(1)}s`);
    if (opts.keepFrames) {
      const dest = join(dirname(resolve(opts.out)), `${basename(opts.out, '.gif')}-frames`);
      await mkdir(dest, { recursive: true });
      for (const f of frames) await copyFile(f, join(dest, basename(f)));
      log(`  关键帧已保留 ${dest}`);
    }
    const encoded = await probe(opts.out);
    return {
      frames: encoded.nbFrames,
      keyframes: frames.length,
      gifDuration: encoded.duration,
      crop: crop ? { x: crop.x, y: crop.y, w: crop.w, h: crop.h } : null,
    };
  } finally {
    await rm(work, { recursive: true, force: true });
  }
}

function defaultOut() {
  const d = new Date();
  const p = (n) => String(n).padStart(2, '0');
  return `s2g-${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}-${p(d.getHours())}${p(d.getMinutes())}${p(d.getSeconds())}.gif`;
}

async function resolveRegion(spec) {
  if (spec === 'screen') return null;
  if (spec === 'window') return frontWindowRegion();
  return parseRect(spec, '--region');
}

async function cmdRecord(opts) {
  const log = (m) => { if (!opts.quiet) process.stderr.write(`${m}\n`); };
  if (opts.interactive && opts.duration) {
    fail('--interactive 由菜单栏的原生停止按钮决定时长，不能与 -d 同用');
  }
  if (opts.then && opts.duration) {
    fail('--then 的时长由命令决定，不能与 -d 同用');
  }
  if (opts.then && opts.interactive) {
    fail('--then 与 --interactive 不能同用（一个由命令控时，一个由菜单栏按钮控时）');
  }
  const work = await mkdtemp(join(tmpdir(), 's2g-rec-'));
  const mov = join(work, 'capture.mov');
  try {
    const region = await resolveRegion(opts.region);
    if (region) log(`  录制区域 ${region.w}x${region.h}+${region.x}+${region.y} (屏幕点)`);

    // --then 编排：真正开录（onStarted 回调）才 spawn 命令，命令退出（until
    // 完成）即停录制。机器输出模式下子命令 stdout 转到 stderr；退出码非 0 只警告，
    // GIF 照常产出——失败的操作过程往往正是要看的东西
    let thenExit = null;
    let launchThen = null;
    const until = opts.then ? new Promise((resolve) => {
      launchThen = () => {
        const child = spawn('/bin/sh', ['-c', opts.then], { stdio: ['inherit', opts.json || opts.quiet ? 2 : 'inherit', 'inherit'] });
        child.on('exit', (code) => { thenExit = code ?? 1; resolve(); });
        child.on('error', (e) => {
          process.stderr.write(`✗ 无法执行 --then 命令：${e.message}\n`);
          thenExit = 1;
          resolve();
        });
      };
    }) : null;

    const rec = await record({
      out: mov, duration: opts.duration, clicks: opts.clicks,
      display: opts.display, region, interactive: opts.interactive,
      countdown: opts.countdown, silent: opts.silent, quiet: opts.quiet,
      onEvent: opts.verbose ? (m) => log(`  $ ${m}`) : null,
      onStarted: launchThen,
      until, readyFile: opts.readyFile,
    });
    log(`  录屏完成 ${fmtBytes(rec.bytes)}`);
    if (thenExit !== null && thenExit !== 0) {
      log(`  ⚠ --then 命令退出码 ${thenExit}（GIF 仍已生成，供排查失败过程）`);
    }
    if (opts.keepMov) {
      const dest = join(dirname(resolve(opts.out)), `${basename(opts.out, '.gif')}.mov`);
      await copyFile(mov, dest);
      log(`  原始录屏已保留 ${dest}`);
    }
    const conv = await convert(mov, opts);
    return { ...conv, thenExit };
  } finally {
    await rm(work, { recursive: true, force: true });
  }
}

async function cmdDoctor() {
  const ok = (b) => (b ? '✓' : '✗');
  const exists = (p) => stat(p).then(() => true, () => false);
  let good = true;
  for (const [name, bin, hint] of [
    ['ffmpeg', ffmpeg, 'brew install ffmpeg'],
    ['ffprobe', ffprobe, 'brew install ffmpeg'],
    ['screencapture', '/usr/sbin/screencapture', '系统自带'],
  ]) {
    const found = await exists(bin);
    process.stdout.write(`${ok(found)} ${name}: ${found ? bin : `未找到 (${hint})`}\n`);
    if (!found) good = false;
  }
  if (good) {
    process.stdout.write('… 试录 1 秒以检查屏幕录制权限\n');
    const perm = await checkPermission();
    process.stdout.write(`${ok(perm.ok)} 屏幕录制权限: ${perm.ok ? `可用 (${perm.width}x${perm.height})` : perm.error}\n`);
    if (!perm.ok) good = false;
  }
  process.stdout.write(good ? '\n一切就绪。\n' : '\n存在问题，见上方 ✗ 项。\n');
  process.exit(good ? 0 : 1);
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  if (!opts.cmd) {
    process.stdout.write(HELP + '\n');
    process.exit(opts.input ? 1 : 0);
  }
  if (opts.cmd === 'doctor') return cmdDoctor();

  if ((opts.then || opts.readyFile) && opts.cmd !== 'record') {
    fail('--then / --ready-file 只在 record 时有效');
  }
  if (opts.cmd === 'convert') {
    if (!opts.input) fail('convert 需要一个输入视频文件');
    if (opts.region !== 'screen') fail('--region 只在 record 时有效；convert 请用 --crop 指定裁剪区域');
    opts.input = resolve(opts.input);
    await stat(opts.input).catch(() => fail(`找不到输入文件 ${opts.input}`));
  } else if (opts.input) {
    fail('record 不接受输入文件；要转已有视频请用 convert <文件>');
  }

  // 依赖先行：缺 ffmpeg 时在录屏前就询问安装，别让用户等录完才发现转不了
  await ensureFfmpeg();

  // -o 支持目录：指向已存在的目录、或以 / 结尾，就往里放默认时间戳文件名；
  // ~/ 前缀也展开（引号里 shell 不展开时 CLI 自己兜）。
  // 注意尾部 / 要在 resolve 之前判断——resolve 会把尾斜杠吃掉
  let out = opts.out || defaultOut();
  if (out.startsWith('~/')) out = join(homedir(), out.slice(2));
  const looksLikeDir = out.endsWith('/');
  out = resolve(out);
  const existing = await stat(out).catch(() => null);
  if (looksLikeDir || existing?.isDirectory()) out = join(out, defaultOut());
  opts.out = out;
  await mkdir(dirname(opts.out), { recursive: true });

  const started = Date.now();
  const conv = opts.cmd === 'record' ? await cmdRecord(opts) : await convert(opts.input, opts);

  if (opts.json) {
    // 单行 JSON 到 stdout，供 agent 程序化取用；人看的日志仍在 stderr（-q 关掉）
    const st = await stat(opts.out);
    const result = {
      ok: true,
      gif: opts.out,
      bytes: st.size,
      frames: conv?.frames ?? null,
      keyframes: conv?.keyframes ?? null,
      gifDuration: conv?.gifDuration ?? null,
      crop: conv?.crop ?? null,
      elapsed: +((Date.now() - started) / 1000).toFixed(1),
    };
    if (conv?.thenExit !== null && conv?.thenExit !== undefined) result.commandExit = conv.thenExit;
    process.stdout.write(JSON.stringify(result) + '\n');
  } else if (opts.quiet) {
    process.stdout.write(`${opts.out}\n`);
  } else {
    const st = await stat(opts.out);
    process.stderr.write(`\n✓ ${opts.out}\n  ${fmtBytes(st.size)}  用时 ${((Date.now() - started) / 1000).toFixed(1)}s\n`);
  }
}

main().catch((err) => {
  process.stderr.write(`\r${' '.repeat(100)}\r`);
  process.stderr.write(`\n✗ ${err.message || String(err)}\n`);
  process.exitCode = 1;
});
